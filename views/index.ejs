<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Manager</title>
    <meta name="description" content="Manage your product inventory — add, edit, and delete products with ease." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="index.css" />
</head>

<body>

    <!-- ── Header ─────────────────────────────────────────── -->
    <header class="header">
        <div class="header-inner">
            <div class="logo">
                <span class="logo-icon">&#9632;</span>
                <span class="logo-text">ProductHub</span>
            </div>
            <button class="btn btn-primary" id="openAddModal">+ New Product</button>
        </div>
    </header>

    <!-- ── Hero / Stats Bar ───────────────────────────────── -->
    <section class="stats-bar" id="statsBar">
        <div class="stat-card">
            <span class="stat-label">Total Products</span>
            <span class="stat-value" id="statTotal">—</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Total Qty</span>
            <span class="stat-value" id="statQty">—</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Avg Price</span>
            <span class="stat-value" id="statAvgPrice">—</span>
        </div>
    </section>

    <!-- ── Search / Filter Bar ────────────────────────────── -->
    <div class="toolbar">
        <input type="search" id="searchInput" class="search-input" placeholder="🔍  Search products…" />
    </div>

    <!-- ── Toast notification ─────────────────────────────── -->
    <div class="toast" id="toast"></div>

    <!-- ── Product Grid ───────────────────────────────────── -->
    <main class="grid-container" id="productGrid">
        <div class="loader" id="loader">
            <div class="spinner"></div>
            <p>Loading products…</p>
        </div>
    </main>

    <!-- ── Empty State ────────────────────────────────────── -->
    <div class="empty-state hidden" id="emptyState">
        <div class="empty-icon">📦</div>
        <h2>No products yet</h2>
        <p>Click <strong>+ New Product</strong> to add your first one.</p>
    </div>

    <!-- ═══════════════════════════════════════════════════════
       MODAL – Add / Edit Product
  ══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop hidden" id="modalBackdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
            <div class="modal-header">
                <h2 id="modalTitle">Add Product</h2>
                <button class="modal-close" id="closeModal" aria-label="Close">&times;</button>
            </div>

            <form id="productForm" novalidate>
                <input type="hidden" id="editId" />

                <div class="form-row two-col">
                    <div class="form-group">
                        <label for="fieldName">Name <span class="required">*</span></label>
                        <input type="text" id="fieldName" placeholder="e.g. Wireless Keyboard" required />
                        <span class="field-error" id="errName"></span>
                    </div>
                    <div class="form-group">
                        <label for="fieldPrice">Price ($) <span class="required">*</span></label>
                        <input type="number" id="fieldPrice" placeholder="0.00" min="0" step="0.01" required />
                        <span class="field-error" id="errPrice"></span>
                    </div>
                </div>

                <div class="form-row two-col">
                    <div class="form-group">
                        <label for="fieldQty">Quantity</label>
                        <input type="number" id="fieldQty" placeholder="0" min="0" />
                    </div>
                    <div class="form-group">
                        <label for="fieldImage">Image URL</label>
                        <input type="url" id="fieldImage" placeholder="https://…" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="fieldDesc">Description</label>
                    <textarea id="fieldDesc" rows="3" placeholder="Short product description…"></textarea>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" id="cancelModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Create Product</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
       MODAL – Delete Confirm
  ══════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop hidden" id="deleteBackdrop">
        <div class="modal modal-sm" role="dialog" aria-modal="true">
            <div class="modal-header">
                <h2>Delete Product?</h2>
                <button class="modal-close" id="closeDeleteModal" aria-label="Close">&times;</button>
            </div>
            <p class="delete-msg">This action cannot be undone. The product <strong id="deleteProductName"></strong>
                will be permanently removed.</p>
            <div class="modal-footer">
                <button class="btn btn-ghost" id="cancelDelete">Cancel</button>
                <button class="btn btn-danger" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>

    <!-- ── View Detail Modal ───────────────────────────────── -->
    <div class="modal-backdrop hidden" id="viewBackdrop">
        <div class="modal" role="dialog" aria-modal="true">
            <div class="modal-header">
                <h2 id="viewTitle">Product Details</h2>
                <button class="modal-close" id="closeViewModal" aria-label="Close">&times;</button>
            </div>
            <div id="viewContent" class="view-content"></div>
        </div>
    </div>

    <script src="index.js"></script>
     
    
</body>

</html>